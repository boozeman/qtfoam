QWidget { background: #101b1c; color: #e6eeed; font-family: "DejaVu Sans", "Arial"; font-size: 14px; }
QFrame#card { background: #172627; border: 1px solid #304b43; border-radius: 10px; }
QLabel { background: transparent; }
QLabel#axis_home { color: #8de3bd; font-weight: bold; }
QLabel#axis_halted { color: #ff7168; font-weight: bold; }
QLabel#brand { color: #8de3bd; font-size: 24px; font-weight: bold; }
QLabel#muted { color: #98b3a8; }
QLabel#footer { color: #98b3a8; font-size: 12px; }
QLabel#value { font-family: "DejaVu Sans Mono", "Consolas"; font-size: 23px; color: #e5f5e9; }
QLabel#badge { border: 1px solid #547968; border-radius: 12px; padding: 8px 16px; color: #a9e7c5; }
QPushButton { background: #254d3e; border: 1px solid #46755e; border-radius: 7px; padding: 10px 16px; min-height: 24px; }
QPushButton:hover { background: #346951; }
QPushButton:pressed { background: #1b392e; }
QPushButton:disabled { color: #6e837a; background: #1a2927; border-color: #2c3f37; }
QPushButton#danger { background: #a83835; border-color: #e66e61; font-weight: bold; }
QPushButton#danger:disabled { background: #492e2b; color: #a38580; }
QTabWidget::pane { border: none; padding-top: 14px; }
QTabBar::tab { padding: 14px 24px; background: #172627; color: #94afa2; border-bottom: 3px solid #172627; }
QTabBar::tab:selected { color: #9cf2c8; border-bottom: 3px solid #7ad6ad; }
QLineEdit, QListWidget, QPlainTextEdit { background: #142120; border: 1px solid #3d5c4c; border-radius: 7px; padding: 10px; }
QLineEdit { font-family: "DejaVu Sans Mono", "Consolas"; font-size: 22px; }
QListWidget::item { padding: 8px; }
QSlider::groove:horizontal { height: 6px; background: #253c35; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #6fc5a4; border-radius: 3px; }
QSlider::handle:horizontal { background: #a0e6c3; border: 1px solid #517f67; width: 18px; margin: -7px 0; border-radius: 6px; }
QSlider::handle:horizontal:disabled { background: #3b554b; }

QScrollBar:vertical { background: #142120; width: 22px; margin: 22px 0; border: none; }
QScrollBar:horizontal { background: #142120; height: 22px; margin: 0 22px; border: none; }
QScrollBar::handle { background: #46755e; border: none; border-radius: 5px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 6px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 6px 2px; }
QScrollBar::handle:hover { background: #7ad6ad; }
QScrollBar::add-line, QScrollBar::sub-line { background: #142120; border: none; }
QScrollBar::sub-line:vertical { height: 22px; subcontrol-position: top; subcontrol-origin: margin; }
QScrollBar::add-line:vertical { height: 22px; subcontrol-position: bottom; subcontrol-origin: margin; }
QScrollBar::sub-line:horizontal { width: 22px; subcontrol-position: left; subcontrol-origin: margin; }
QScrollBar::add-line:horizontal { width: 22px; subcontrol-position: right; subcontrol-origin: margin; }
QScrollBar::up-arrow { image: url(qtfoam_icons:arrow-up.svg); width: 16px; height: 16px; }
QScrollBar::down-arrow { image: url(qtfoam_icons:arrow-down.svg); width: 16px; height: 16px; }
QScrollBar::left-arrow { image: url(qtfoam_icons:arrow-left.svg); width: 16px; height: 16px; }
QScrollBar::right-arrow { image: url(qtfoam_icons:arrow-right.svg); width: 16px; height: 16px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
